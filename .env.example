# Copy this file to `.env` and fill in your own values.

# Port the API server listens on
PORT=3001

# YouTube Data API v3 key (optional but recommended).
# Without it, metadata is fetched from the YouTube oEmbed endpoint (title, channel, thumbnail).
YOUTUBE_API_KEY=

# --- Optional OpenAI-compatible LLM ---
# When USER_LLM_API_KEY and USER_LLM_BASE_URL are set, AI analysis is generated by an
# external OpenAI-compatible chat completions API. Otherwise a built-in rule-based
# generator is used as a graceful fallback.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat
